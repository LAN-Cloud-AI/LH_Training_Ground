# TikHub：经本机主服务统一调用，不支持收费直连或手工 RPM。
TIKHUB_GATEWAY_URL=http://127.0.0.1:3000
# 与主服务 INTERNAL_API_TOKEN 一致，仅注入服务环境，不在网页配置。
TIKHUB_GATEWAY_TOKEN=

# LLM：fake 可离线跑通；deepseek 需填 key
CSL_LLM_PROVIDER=fake
CSL_LLM_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
CSL_LLM_TEMPERATURE=0.0

# Cloudflare Access 用户管理（也可在网页「配置」页填写）
# 权限：Access: Apps and Policies Edit；Access: Organizations Read
CLOUDFLARE_API_TOKEN=
CF_ACCESS_TEAM_DOMAIN=long-sky-131d.cloudflareaccess.com
# 以下一般无需改（已有默认值）
# CF_ACCESS_ACCOUNT_ID=
# CF_ACCESS_TRAINING_APP_ID=
# CF_ACCESS_TRAINING_POLICY_ID=
# CF_ACCESS_LAUNCHER_APP_ID=
# CF_ACCESS_LAUNCHER_POLICY_ID=
