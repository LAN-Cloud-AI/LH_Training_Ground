{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentSentimentResult_UsedCar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item_id",
    "sentiment_polarity",
    "sentiment_intensity",
    "aspects",
    "competitor_mentions",
    "brand_stance",
    "content_role",
    "opinion_risk",
    "summary",
    "reason",
    "confidence"
  ],
  "properties": {
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "sentiment_polarity": {
      "type": "string",
      "enum": [
        "positive",
        "neutral",
        "negative",
        "mixed"
      ]
    },
    "sentiment_intensity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "aspects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "polarity",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "exterior",
              "driving",
              "range",
              "smart_drive",
              "price",
              "delivery",
              "service",
              "quality",
              "space",
              "competitor"
            ]
          },
          "polarity": {
            "type": "string",
            "enum": [
              "positive",
              "neutral",
              "negative",
              "mixed"
            ]
          },
          "evidence": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    },
    "competitor_mentions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "brand",
          "series",
          "stance"
        ],
        "properties": {
          "brand": {
            "type": [
              "string",
              "null"
            ]
          },
          "series": {
            "type": [
              "string",
              "null"
            ]
          },
          "stance": {
            "type": "string",
            "enum": [
              "prefer_own",
              "prefer_competitor",
              "neutral",
              "unclear"
            ]
          }
        }
      }
    },
    "brand_stance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "own",
        "overall"
      ],
      "properties": {
        "own": {
          "type": "string",
          "enum": [
            "positive",
            "neutral",
            "negative",
            "mixed",
            "unclear"
          ]
        },
        "overall": {
          "type": "string",
          "enum": [
            "positive",
            "neutral",
            "negative",
            "mixed",
            "unclear"
          ]
        }
      }
    },
    "content_role": {
      "type": "string",
      "enum": [
        "owner_review",
        "prospect_research",
        "dealer_ad",
        "media",
        "unrelated",
        "unknown"
      ]
    },
    "opinion_risk": {
      "type": "string",
      "enum": [
        "low",
        "mid",
        "high"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 120
    },
    "reason": {
      "type": "string",
      "maxLength": 80
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "inferred_city": {
      "type": [
        "string",
        "null"
      ],
      "description": "当输入 city 为空时，根据标题+正文推断的发帖城市；无法判断则为 null。输入已有 city 时必须输出 null。",
      "maxLength": 32
    }
  }
}
